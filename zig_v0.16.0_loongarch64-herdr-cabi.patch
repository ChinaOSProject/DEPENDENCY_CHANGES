+const std = @import("std");
+const Type = @import("../../Type.zig");
+const Zcu = @import("../../Zcu.zig");
+
+pub const Fields = struct {
+    types: [2]Type = undefined,
+    len: u32 = 0,
+};
+
+pub const Class = union(enum) {
+    memory,
+    byval,
+    integer,
+    fields: Fields,
+};
+
+pub fn classifyType(ty: Type, zcu: *Zcu) Class {
+    const target = zcu.getTarget();
+    std.debug.assert(target.cpu.arch == .loongarch64);
+    std.debug.assert(ty.hasRuntimeBits(zcu));
+
+    switch (ty.zigTypeTag(zcu)) {
+        .@"struct" => {
+            if (ty.containerLayout(zcu) != .@"packed") {
+                const flen: u16 = switch (target.abi) {
+                    .gnusf, .muslsf => 0,
+                    .gnuf32, .muslf32 => 32,
+                    else => 64,
+                };
+                var fields: Fields = .{};
+                var any_float = false;
+                if (flattenFields(ty, zcu, flen, &fields, &any_float) and any_float) {
+                    return .{ .fields = fields };
+                }
+            }
+            return classifyAggregate(ty, zcu);
+        },
+        .@"union", .vector => return classifyAggregate(ty, zcu),
+        .int => return if (ty.bitSize(zcu) > 128) .memory else .byval,
+        else => return .byval,
+    }
+}
+
+pub fn classifyArg(ty: Type, zcu: *Zcu, gprs: *u8, fprs: *u8, is_vararg: bool) Class {
+    var class = classifyType(ty, zcu);
+    if (class == .fields) {
+        var required_gprs: u8 = 0;
+        var required_fprs: u8 = 0;
+        for (class.fields.types[0..class.fields.len]) |field_ty| {
+            if (field_ty.isRuntimeFloat()) {
+                required_fprs += 1;
+            } else {
+                required_gprs += 1;
+            }
+        }
+        if (!is_vararg and gprs.* >= required_gprs and fprs.* >= required_fprs) {
+            gprs.* -= required_gprs;
+            fprs.* -= required_fprs;
+            return class;
+        }
+        class = classifyAggregate(ty, zcu);
+    }
+    if (ty.isRuntimeFloat()) {
+        const flen: u16 = switch (zcu.getTarget().abi) {
+            .gnusf, .muslsf => 0,
+            .gnuf32, .muslf32 => 32,
+            else => 64,
+        };
+        if (!is_vararg and ty.bitSize(zcu) <= flen and fprs.* > 0) {
+            fprs.* -= 1;
+            return class;
+        }
+        if (is_vararg) class = classifyAggregate(ty, zcu);
+    }
+    const required_gprs: u8 = if (class == .memory) 1 else @intCast((ty.abiSize(zcu) + 7) / 8);
+    gprs.* -|= required_gprs;
+    return class;
+}
+
+fn classifyAggregate(ty: Type, zcu: *Zcu) Class {
+    const size = ty.abiSize(zcu);
+    if (size > 16) return .memory;
+    return .integer;
+}
+
+fn flattenFields(ty: Type, zcu: *Zcu, flen: u16, fields: *Fields, any_float: *bool) bool {
+    if (!ty.hasRuntimeBits(zcu)) return true;
+    switch (ty.zigTypeTag(zcu)) {
+        .@"struct" => {
+            if (ty.containerLayout(zcu) == .@"packed") return false;
+            for (0..ty.structFieldCount(zcu)) |i| {
+                if (!flattenFields(ty.fieldType(i, zcu), zcu, flen, fields, any_float)) return false;
+            }
+            return true;
+        },
+        .array => {
+            for (0..ty.arrayLen(zcu)) |_| {
+                if (!flattenFields(ty.childType(zcu), zcu, flen, fields, any_float)) return false;
+            }
+            return true;
+        },
+        .float => {
+            if (ty.bitSize(zcu) > flen) return false;
+            any_float.* = true;
+        },
+        .bool, .pointer, .optional, .int, .@"enum", .error_set => {
+            if (ty.abiSize(zcu) > 8) return false;
+        },
+        else => return false,
+    }
+    if (fields.len == fields.types.len) return false;
+    fields.types[fields.len] = ty;
+    fields.len += 1;
+    return true;
+}
