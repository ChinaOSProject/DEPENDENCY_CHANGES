index 0000000..a13fa2d
--- /dev/null
+++ b/src/slic3r/GUI/DeviceWeb/stage-loongarch64-device-page.cmake
@@ -0,0 +1,26 @@
+cmake_minimum_required(VERSION 3.13)
+
+find_program(PATCH_EXECUTABLE patch)
+if(NOT PATCH_EXECUTABLE)
+    message(FATAL_ERROR "LoongArch64 DeviceWeb builds require patch.")
+endif()
+
+file(REMOVE_RECURSE "${STAGE_DIR}")
+file(COPY "${SOURCE_DIR}/" DESTINATION "${STAGE_DIR}"
+    PATTERN "node_modules" EXCLUDE
+    PATTERN "dist" EXCLUDE)
+
+execute_process(
+    COMMAND "${CMAKE_COMMAND}" -E create_symlink "${RESOURCES_DIR}" "${STAGE_ROOT}/resources"
+    RESULT_VARIABLE resource_link_result)
+if(NOT resource_link_result STREQUAL "0")
+    message(FATAL_ERROR "Cannot link resources for the LoongArch64 DeviceWeb build (${resource_link_result}).")
+endif()
+
+execute_process(
+    COMMAND "${PATCH_EXECUTABLE}" --batch --forward --fuzz=0 -p1 -i "${PACKAGE_PATCH}"
+    WORKING_DIRECTORY "${STAGE_DIR}"
+    RESULT_VARIABLE patch_result)
+if(NOT patch_result STREQUAL "0")
+    message(FATAL_ERROR "DeviceWeb LoongArch64 package patch failed (${patch_result}).")
+endif()
