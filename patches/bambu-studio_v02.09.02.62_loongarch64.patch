diff --git a/cmake/modules/FindCGAL.cmake b/cmake/modules/FindCGAL.cmake
new file mode 100644
index 0000000..2ef5238
--- /dev/null
+++ b/cmake/modules/FindCGAL.cmake
@@ -0,0 +1,64 @@
+find_package(CGAL CONFIG QUIET)
+if(CGAL_FOUND)
+    return()
+endif()
+
+find_path(CGAL_INCLUDE_DIR
+    NAMES CGAL/config.h
+)
+
+if(CGAL_DIR AND EXISTS "${CGAL_DIR}/CGAL_SetupCGALDependencies.cmake")
+    set(CGAL_MODULES_DIR "${CGAL_DIR}")
+else()
+    find_path(CGAL_MODULES_DIR
+        NAMES CGAL_SetupCGALDependencies.cmake
+        PATHS ${CMAKE_PREFIX_PATH}
+        PATH_SUFFIXES
+            "lib/${CMAKE_LIBRARY_ARCHITECTURE}/cmake/CGAL"
+            lib/cmake/CGAL
+    )
+endif()
+
+if(CGAL_INCLUDE_DIR AND CGAL_MODULES_DIR)
+    include("${CGAL_MODULES_DIR}/CGAL_parse_version_h.cmake")
+    cgal_parse_version_h("${CGAL_INCLUDE_DIR}/CGAL/version.h"
+        "CGAL_VERSION_NAME"
+        "CGAL_MAJOR_VERSION"
+        "CGAL_MINOR_VERSION"
+        "CGAL_BUGFIX_VERSION"
+        "CGAL_BUILD_VERSION"
+    )
+    set(CGAL_VERSION "${CGAL_MAJOR_VERSION}.${CGAL_MINOR_VERSION}.${CGAL_BUGFIX_VERSION}.${CGAL_BUILD_VERSION}")
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(CGAL
+    REQUIRED_VARS CGAL_INCLUDE_DIR CGAL_MODULES_DIR
+    VERSION_VAR CGAL_VERSION
+)
+
+if(NOT CGAL_FOUND)
+    return()
+endif()
+
+set(CGAL_CONFIG_DIR "${CGAL_MODULES_DIR}")
+get_filename_component(CGAL_INSTALLATION_PACKAGE_DIR "${CGAL_INCLUDE_DIR}" DIRECTORY)
+set(CGAL_GRAPHICSVIEW_PACKAGE_DIR "${CGAL_INSTALLATION_PACKAGE_DIR}")
+set(CGAL_INCLUDE_DIRS "${CGAL_INCLUDE_DIR}")
+set(CGAL_LIBRARIES CGAL)
+set(CGAL_HEADER_ONLY TRUE)
+set(CGAL_USE_FILE "${CGAL_MODULES_DIR}/UseCGAL.cmake")
+
+list(APPEND CMAKE_MODULE_PATH "${CGAL_MODULES_DIR}")
+include("${CGAL_MODULES_DIR}/CGAL_SetupCGALDependencies.cmake")
+include("${CGAL_MODULES_DIR}/CGAL_setup_target_dependencies.cmake")
+include("${CGAL_MODULES_DIR}/CGAL_target_use_TBB.cmake")
+
+if(NOT TARGET CGAL)
+    add_library(CGAL INTERFACE IMPORTED GLOBAL)
+endif()
+if(NOT TARGET CGAL::CGAL)
+    add_library(CGAL::CGAL ALIAS CGAL)
+endif()
+
+CGAL_setup_target_dependencies(CGAL INTERFACE)
diff --git a/cmake/modules/FindOpenCASCADE.cmake b/cmake/modules/FindOpenCASCADE.cmake
new file mode 100644
index 0000000..2ddb490
--- /dev/null
+++ b/cmake/modules/FindOpenCASCADE.cmake
@@ -0,0 +1,75 @@
+set(_OpenCASCADE_components
+    TKXDESTEP
+    TKSTEP
+    TKSTEP209
+    TKSTEPAttr
+    TKSTEPBase
+    TKXCAF
+    TKXSBase
+    TKVCAF
+    TKCAF
+    TKLCAF
+    TKCDF
+    TKV3d
+    TKService
+    TKMesh
+    TKBO
+    TKPrim
+    TKHLR
+    TKShHealing
+    TKTopAlgo
+    TKGeomAlgo
+    TKBRep
+    TKGeomBase
+    TKG3d
+    TKG2d
+    TKMath
+    TKernel
+)
+
+set(_OpenCASCADE_prefixes ${CMAKE_PREFIX_PATH})
+if(NOT _OpenCASCADE_prefixes AND DEFINED PREFIX_PATH_CHECK)
+    set(_OpenCASCADE_prefixes ${PREFIX_PATH_CHECK})
+endif()
+if(NOT _OpenCASCADE_prefixes AND DEFINED ENV{CMAKE_PREFIX_PATH})
+    set(_OpenCASCADE_prefixes $ENV{CMAKE_PREFIX_PATH})
+endif()
+
+find_path(OpenCASCADE_INCLUDE_DIR
+    NAMES Standard.hxx
+    PATHS ${_OpenCASCADE_prefixes}
+    PATH_SUFFIXES include/opencascade include
+    NO_DEFAULT_PATH
+)
+
+set(_OpenCASCADE_missing "")
+foreach(_OpenCASCADE_component IN LISTS _OpenCASCADE_components)
+    find_library(_OpenCASCADE_library_${_OpenCASCADE_component}
+        NAMES ${_OpenCASCADE_component}
+        PATHS ${_OpenCASCADE_prefixes}
+        PATH_SUFFIXES lib/${CMAKE_LIBRARY_ARCHITECTURE} lib
+        NO_DEFAULT_PATH
+    )
+    if(NOT _OpenCASCADE_library_${_OpenCASCADE_component})
+        list(APPEND _OpenCASCADE_missing ${_OpenCASCADE_component})
+    elseif(NOT OpenCASCADE_LIBRARY_DIR)
+        get_filename_component(OpenCASCADE_LIBRARY_DIR
+            "${_OpenCASCADE_library_${_OpenCASCADE_component}}" DIRECTORY
+        )
+    endif()
+endforeach()
+
+if(_OpenCASCADE_missing)
+    set(OpenCASCADE_LIBRARY_DIR "OpenCASCADE_LIBRARY_DIR-NOTFOUND")
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(OpenCASCADE
+    REQUIRED_VARS OpenCASCADE_INCLUDE_DIR OpenCASCADE_LIBRARY_DIR
+)
+
+if(OpenCASCADE_FOUND)
+    link_directories("${OpenCASCADE_LIBRARY_DIR}")
+endif()
+
+mark_as_advanced(OpenCASCADE_INCLUDE_DIR OpenCASCADE_LIBRARY_DIR)
