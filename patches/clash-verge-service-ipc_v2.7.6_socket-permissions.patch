Subject: [PATCH] fix(service): secure IPC socket permissions by inode

---
 src/core/manager.rs | 245 +++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 222 insertions(+), 23 deletions(-)

diff --git a/src/core/manager.rs b/src/core/manager.rs
index e1b14cf..c63578f 100644
--- a/src/core/manager.rs
+++ b/src/core/manager.rs
@@ -911,9 +911,64 @@ fn grant_core_ipc_directory_to_owner(target: &std::path::Path, uid: u32, gid: u3
     result
 }
 
+#[cfg(target_os = "linux")]
+fn open_core_ipc_socket(target: &std::path::Path, expected: &std::fs::Metadata) -> Result<std::fs::File> {
+    use std::os::unix::fs::{FileTypeExt as _, MetadataExt as _, OpenOptionsExt as _};
+
+    let socket = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(platform_lib::O_PATH | platform_lib::O_NOFOLLOW | platform_lib::O_CLOEXEC)
+        .open(target)
+        .context("failed to pin core IPC socket")?;
+    let metadata = socket.metadata().context("failed to inspect pinned core IPC socket")?;
+    // O_PATH | O_NOFOLLOW opens a symlink itself, so opening successfully is not enough.
+    if !metadata.file_type().is_socket() || metadata.dev() != expected.dev() || metadata.ino() != expected.ino() {
+        anyhow::bail!("core IPC socket was replaced before it could be secured");
+    }
+    Ok(socket)
+}
+
+#[cfg(target_os = "linux")]
+fn secure_core_ipc_socket_fd(socket: &std::fs::File, uid: u32, gid: u32) -> Result<()> {
+    use std::os::fd::AsRawFd as _;
+    use std::os::unix::fs::FileTypeExt as _;
+
+    if !socket.metadata()?.file_type().is_socket() {
+        anyhow::bail!("pinned core IPC entry is not a socket");
+    }
+    let fd = socket.as_raw_fd();
+    if unsafe { platform_lib::geteuid() } == 0
+        && unsafe { platform_lib::fchownat(fd, c"".as_ptr(), uid, gid, platform_lib::AT_EMPTY_PATH) } != 0
+    {
+        return Err(std::io::Error::last_os_error()).context("failed to set core IPC socket owner");
+    }
+
+    if unsafe { platform_lib::fchmodat(fd, c"".as_ptr(), 0o600, platform_lib::AT_EMPTY_PATH) } == 0 {
+        return Ok(());
+    }
+    let error = std::io::Error::last_os_error();
+    if !matches!(
+        error.raw_os_error(),
+        Some(platform_lib::EINVAL | platform_lib::ENOSYS | platform_lib::EOPNOTSUPP)
+    ) {
+        return Err(error).context("failed to make core IPC socket private");
+    }
+
+    // fchmod cannot operate on O_PATH descriptors. Like glibc's nofollow fallback,
+    // follow only this procfs magic link to the pinned inode, never the original path.
+    // Keep `socket` alive throughout; missing/inaccessible procfs must fail closed.
+    let path = std::ffi::CString::new(format!("/proc/self/fd/{fd}"))?;
+    if unsafe { platform_lib::fchmodat(platform_lib::AT_FDCWD, path.as_ptr(), 0o600, 0) } != 0 {
+        return Err(std::io::Error::last_os_error())
+            .context("failed to make pinned core IPC socket private via procfs");
+    }
+    Ok(())
+}
+
 async fn secure_core_ipc_socket(core_ipc_path: String, owner: OwnerIdentity, expected_pid: Option<u32>) -> Result<()> {
     #[cfg(unix)]
     {
+        #[cfg(not(target_os = "linux"))]
         use std::os::unix::ffi::OsStrExt as _;
         use std::os::unix::fs::FileTypeExt as _;
 
@@ -922,20 +977,18 @@ async fn secure_core_ipc_socket(core_ipc_path: String, owner: OwnerIdentity, exp
             anyhow::bail!("Unix core IPC path received a non-Unix owner");
         };
         let target = std::path::PathBuf::from(core_ipc_path);
-        let mut found = false;
         let deadline = tokio::time::Instant::now() + CORE_IPC_READY_TIMEOUT;
-        loop {
+        let metadata = loop {
             match tokio::fs::symlink_metadata(&target).await {
                 Ok(metadata) if metadata.file_type().is_socket() => {
-                    found = true;
-                    break;
+                    break metadata;
                 }
                 Ok(_) => {
                     anyhow::bail!("core IPC path {target:?} is not a socket");
                 }
                 Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
                     if tokio::time::Instant::now() >= deadline {
-                        break;
+                        anyhow::bail!("core IPC socket did not appear at {target:?} within {CORE_IPC_READY_TIMEOUT:?}");
                     }
                     tokio::time::sleep(CORE_IPC_POLL_INTERVAL).await;
                 }
@@ -943,25 +996,37 @@ async fn secure_core_ipc_socket(core_ipc_path: String, owner: OwnerIdentity, exp
                     return Err(error.into());
                 }
             }
+        };
+        #[cfg(target_os = "linux")]
+        {
+            use std::os::unix::fs::MetadataExt as _;
+
+            let socket = open_core_ipc_socket(&target, &metadata)?;
+            secure_core_ipc_socket_fd(&socket, uid, gid)?;
+            let current = std::fs::symlink_metadata(&target)?;
+            if current.dev() != metadata.dev() || current.ino() != metadata.ino() {
+                anyhow::bail!("core IPC socket was replaced while being secured");
+            }
         }
-        if !found {
-            anyhow::bail!("core IPC socket did not appear at {target:?} within {CORE_IPC_READY_TIMEOUT:?}");
-        }
-        let path = std::ffi::CString::new(target.as_os_str().as_bytes())
-            .map_err(|_| anyhow::anyhow!("core IPC socket path contains NUL"))?;
-        let chown_ok =
-            unsafe { platform_lib::geteuid() } != 0 || unsafe { platform_lib::lchown(path.as_ptr(), uid, gid) } == 0;
-        let chmod_ok = unsafe {
-            platform_lib::fchmodat(
-                platform_lib::AT_FDCWD,
-                path.as_ptr(),
-                0o600 as platform_lib::mode_t,
-                platform_lib::AT_SYMLINK_NOFOLLOW,
-            )
-        } == 0;
-        let os_error = (!chown_ok || !chmod_ok).then(std::io::Error::last_os_error);
-        if !chown_ok || !chmod_ok {
-            return Err(os_error.unwrap_or_else(std::io::Error::last_os_error).into());
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = metadata;
+            let path = std::ffi::CString::new(target.as_os_str().as_bytes())
+                .map_err(|_| anyhow::anyhow!("core IPC socket path contains NUL"))?;
+            let chown_ok = unsafe { platform_lib::geteuid() } != 0
+                || unsafe { platform_lib::lchown(path.as_ptr(), uid, gid) } == 0;
+            let chmod_ok = unsafe {
+                platform_lib::fchmodat(
+                    platform_lib::AT_FDCWD,
