@@ -1118,6 +1183,140 @@ mod tests {
         std::fs::remove_dir_all(directory)?;
         Ok(())
     }
+
+    fn socket_test_directory(name: &str) -> anyhow::Result<std::path::PathBuf> {
+        let directory = std::env::temp_dir().join(format!("cvs-{}-{name}", std::process::id()));
+        if directory.exists() {
+            std::fs::remove_dir_all(&directory)?;
+        }
+        std::fs::create_dir(&directory)?;
+        Ok(directory)
+    }
+
+    #[tokio::test]
+    async fn core_socket_rejects_symlink() -> anyhow::Result<()> {
+        use std::os::unix::fs::{MetadataExt as _, symlink};
+
+        let directory = socket_test_directory("symlink")?;
+        let victim = directory.join("victim");
+        std::fs::write(&victim, b"unchanged")?;
+        std::fs::set_permissions(&victim, std::fs::Permissions::from_mode(0o640))?;
+        let before = std::fs::metadata(&victim)?;
+        let path = directory.join("core.sock");
+        symlink(&victim, &path)?;
+        let owner = OwnerIdentity::Unix {
+            uid: unsafe { platform_lib::geteuid() },
+            gid: unsafe { platform_lib::getegid() },
+        };
+
+        let error = secure_core_ipc_socket(path.to_string_lossy().into_owned(), owner, None)
+            .await
+            .expect_err("a symlink must not be accepted as a core socket");
+        assert!(error.to_string().contains("not a socket"));
+        let after = std::fs::metadata(&victim)?;
+        assert_eq!(
+            (after.mode(), after.uid(), after.gid()),
+            (before.mode(), before.uid(), before.gid())
+        );
+        assert_eq!(std::fs::read(&victim)?, b"unchanged");
+        std::fs::remove_dir_all(directory)?;
+        Ok(())
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn core_socket_rejects_replacement_before_pinning() -> anyhow::Result<()> {
+        use std::os::unix::fs::{MetadataExt as _, symlink};
+        use std::os::unix::net::UnixListener;
+
+        let directory = socket_test_directory("before-pin")?;
+        let path = directory.join("core.sock");
+        let listener = UnixListener::bind(&path)?;
+        let expected = std::fs::symlink_metadata(&path)?;
+        std::fs::rename(&path, directory.join("original.sock"))?;
+        let victim = directory.join("victim");
+        std::fs::write(&victim, b"unchanged")?;
+        std::fs::set_permissions(&victim, std::fs::Permissions::from_mode(0o640))?;
+        let before = std::fs::metadata(&victim)?;
+
+        symlink(&victim, &path)?;
+        assert!(super::open_core_ipc_socket(&path, &expected).is_err());
+        std::fs::remove_file(&path)?;
+        std::fs::hard_link(&victim, &path)?;
+        assert!(super::open_core_ipc_socket(&path, &expected).is_err());
+        std::fs::remove_file(&path)?;
+        let replacement = UnixListener::bind(&path)?;
+        let replacement_mode = std::fs::metadata(&path)?.mode();
+        assert!(super::open_core_ipc_socket(&path, &expected).is_err());
+        assert_eq!(std::fs::metadata(&path)?.mode(), replacement_mode);
+        // O_PATH | O_NOFOLLOW must reject even a symlink pointing to a socket.
+        std::fs::remove_file(&path)?;
+        symlink(directory.join("original.sock"), &path)?;
+        assert!(super::open_core_ipc_socket(&path, &expected).is_err());
+
+        let after = std::fs::metadata(&victim)?;
+        assert_eq!(
+            (after.mode(), after.uid(), after.gid()),
+            (before.mode(), before.uid(), before.gid())
+        );
+        drop((listener, replacement));
+        std::fs::remove_dir_all(directory)?;
+        Ok(())
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn core_socket_permissions_stay_on_pinned_inode() -> anyhow::Result<()> {
+        use std::os::unix::fs::{MetadataExt as _, symlink};
+        use std::os::unix::net::UnixListener;
+
+        let directory = socket_test_directory("after-pin")?;
+        let victim = directory.join("victim");
+        std::fs::write(&victim, b"unchanged")?;
+        std::fs::set_permissions(&victim, std::fs::Permissions::from_mode(0o640))?;
+        let before = std::fs::metadata(&victim)?;
+        let root = unsafe { platform_lib::geteuid() } == 0;
+        let uid = if root { 1 } else { unsafe { platform_lib::geteuid() } };
+        let gid = if root { 1 } else { unsafe { platform_lib::getegid() } };
+
+        for is_symlink in [true, false] {
+            let path = directory.join("core.sock");
+            let pinned_path = directory.join("pinned.sock");
+            let listener = UnixListener::bind(&path)?;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o666))?;
+            let expected = std::fs::symlink_metadata(&path)?;
+            let socket = super::open_core_ipc_socket(&path, &expected)?;
+            std::fs::rename(&path, &pinned_path)?;
+            if is_symlink {
+                symlink(&victim, &path)?;
+            } else {
+                std::fs::hard_link(&victim, &path)?;
+            }
+            let replacement = std::fs::symlink_metadata(&path)?;
+
+            super::secure_core_ipc_socket_fd(&socket, uid, gid)?;
+
+            let pinned = std::fs::metadata(&pinned_path)?;
+            assert_eq!(pinned.mode() & 0o7777, 0o600);
+            assert_eq!((pinned.uid(), pinned.gid()), (uid, gid));
+            let after = std::fs::metadata(&victim)?;
+            assert_eq!(
+                (after.mode(), after.uid(), after.gid()),
+                (before.mode(), before.uid(), before.gid())
+            );
+            let current = std::fs::symlink_metadata(&path)?;
+            assert_eq!(
+                (current.mode(), current.uid(), current.gid()),
+                (replacement.mode(), replacement.uid(), replacement.gid())
+            );
+            drop((socket, listener));
+            std::fs::remove_file(&path)?;
+            std::fs::remove_file(&pinned_path)?;
+        }
+        assert_eq!(std::fs::read(&victim)?, b"unchanged");
+        std::fs::remove_dir_all(directory)?;
+        Ok(())
+    }
 }
 
